class ParallelCNNa(Network):
    def __init__(self, settings):
        super().__init__(settings)
        self.vert_stack = nn.Sequential(
            # 3x3x16 -> 36x5x16
            nn.Conv2d(3, 36, (3, 1), padding=(2, 0), padding_mode="zeros", groups=3), 
            nn.GELU(),
            nn.Dropout(self.do),
 
            # 36x5x16 -> 36x7x16
            nn.Conv2d(36, 36, (3, 1), padding=(2, 0), padding_mode="zeros", groups=12),
            nn.GELU(),
            nn.Dropout(self.do),

            # 36x7x16 -> 36x7x16
            nn.Conv2d(36, 36, (3, 1), padding=(2, 0), padding_mode="zeros", groups=12),
            nn.GELU(),
            nn.Dropout(self.do),
 
            nn.Flatten(),
 
            nn.Linear(5184, 2048),
            nn.GELU(),
            nn.Dropout(self.do)
        )

        self.horz_stack = nn.Sequential(
            # 3x3x16 -> 36x3x18
            nn.Conv2d(3, 36, (1, self.n_coeffs), padding=(0, self.n_coeffs//2+1), padding_mode="zeros", groups=3), 
            nn.GELU(),
            nn.Dropout(self.do),
 
            # 36x3x18 -> 72x3x18
            nn.Conv2d(36, 72, (1, self.n_coeffs), padding=(0, self.n_coeffs//2+1), padding_mode="zeros", groups=12),
            nn.GELU(),
            nn.Dropout(self.do),

            # 72x3x18 -> 72x3x18
            nn.Conv2d(72, 72, (1, self.n_coeffs), padding=(0, self.n_coeffs//2+1), padding_mode="zeros", groups=12),
            nn.GELU(),
            nn.Dropout(self.do),
 
            nn.Flatten(),
 
            nn.Linear(5400, 2048),
            nn.GELU(),
            nn.Dropout(self.do)
        )

        self.comb_stack = nn.Sequential(
            nn.Linear(4096, 1024),
            nn.GELU(),
            nn.Dropout(self.do),

            nn.Linear(1024, 256),
            nn.GELU(),
            nn.Dropout(self.do),

            nn.Linear(256, self.n_coeffs)
        )

    def forward(self, x):
        x = x.transpose(2, -1).contiguous()
        x1 = self.vert_stack(x)
        x2 = self.horz_stack(x)
        x = torch.cat([x1, x2], 1)
        return self.comb_stack(x)
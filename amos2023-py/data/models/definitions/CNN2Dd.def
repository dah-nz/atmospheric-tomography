class CNN2Dd(Network):
    def __init__(self, settings):
        super().__init__(settings)

        self.model_stack = nn.Sequential(
            # 3x3x16 -> 18x5x18
            nn.Conv2d(3, 18, (3, 3), padding=2, padding_mode="circular", groups=3), 
            nn.GELU(),
            nn.Dropout(self.do),
 
            # 18x5x18 -> 54x5x18
            nn.Conv2d(18, 54, (3, 3), padding=1, padding_mode="circular", groups=2),
            nn.GELU(),
            nn.Dropout(self.do),

            # 54x5x18 -> 162x3x16
            nn.Conv2d(54, 162, (3, 3), padding=0, padding_mode="circular", groups=1),
            nn.GELU(),
            nn.Dropout(self.do),

            # 162x3x16 -> 486x1x14
            nn.Conv2d(162, 486, (3, 3), padding=0, padding_mode="circular", groups=2),
            nn.GELU(),
            nn.Dropout(self.do),

            # 486x1x14 -> 1458x1x12
            nn.Conv2d(486, 1458, (1, 3), padding=0, padding_mode="circular", groups=3),
            nn.GELU(),
            nn.Dropout(self.do),
 
            nn.Flatten(),
 
            nn.Linear(17496, 4096),
            nn.GELU(),
            nn.Dropout(self.do),

            nn.Linear(4096, 256),
            nn.GELU(),
            nn.Dropout(self.do),

            nn.Linear(256, self.n_coeffs)

        )
    def forward(self, x):
        x = x.transpose(2, -1).contiguous()
        return self.model_stack(x)
class CNN2Da(Network):
    def __init__(self, settings):
        super().__init__(settings)

        self.model_stack = nn.Sequential(
            # 3x3x32 -> 18x5x34
            nn.Conv2d(3, 18, (3, 3), padding=(2, 2), padding_mode="circular", groups=1), 
            nn.LeakyReLU(self.LRELU_grad, True),
            nn.Dropout(self.do),
 
            # 18x5x34 -> 18x5x34
            nn.Conv2d(18, 18, (3, 3), padding=1, padding_mode="circular", groups=18),
            nn.LeakyReLU(self.LRELU_grad, True),
            nn.Dropout(self.do),

            # 18x5x34 -> 18x5x34
            nn.Conv2d(18, 18, (3, 3), padding=1, padding_mode="circular", groups=1),
            nn.LeakyReLU(self.LRELU_grad, True),
            nn.Dropout(self.do),

            # 18x5x34 -> 6x5x34
            nn.Conv2d(18, 6, (3, 3), padding=1, padding_mode="circular", groups=6),
            nn.LeakyReLU(self.LRELU_grad, True),
            nn.Dropout(self.do),
 
            nn.Flatten(),
 
            nn.Linear(540, 512),
            nn.LeakyReLU(self.LRELU_grad, True),
            nn.Dropout(self.do),

            nn.Linear(512, self.n_coeffs)

        )
    def forward(self, x):
        x = x.transpose(2, -1).contiguous()
        return self.model_stack(x)
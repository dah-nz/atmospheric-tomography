class ParallelCNN(Network):
    def __init__(self, settings):
        super().__init__(settings)
        self.vert_stack = nn.Sequential(
            # 3x3x32 -> 12x5x32
            nn.Conv2d(3, 36, (3, 1), padding=(2, 0), padding_mode="zeros", groups=3), 
            nn.GELU(),
            nn.Dropout(self.do),
 
            # 12x5x32 -> 12x7x32
            nn.Conv2d(36, 24, (3, 1), padding=(2, 0), padding_mode="zeros", groups=2),
            nn.GELU(),
            nn.Dropout(self.do),

            # 12x7x32 -> 12x9x32
            nn.Conv2d(24, 12, (3, 1), padding=(2, 0), padding_mode="zeros", groups=1),
            nn.GELU(),
            nn.Dropout(self.do),
 
            nn.Flatten(),
 
            nn.Linear(1728, 1024),
            nn.GELU(),
            nn.Dropout(self.do)
        )

        self.horz_stack = nn.Sequential(
            # 3x3x32 -> 12x3x34
            nn.Conv2d(3, 12, (1, self.n_coeffs), padding=(0, self.n_coeffs//2+1), padding_mode="zeros", groups=3), 
            nn.GELU(),
            nn.Dropout(self.do),
 
            # 12x3x34 -> 12x3x36
            nn.Conv2d(12, 24, (1, self.n_coeffs), padding=(0, self.n_coeffs//2+1), padding_mode="zeros", groups=2),
            nn.GELU(),
            nn.Dropout(self.do),

            # 12x3x36 -> 12x3x38
            nn.Conv2d(24, 36, (1, self.n_coeffs), padding=(0, self.n_coeffs//2+1), padding_mode="zeros", groups=1),
            nn.GELU(),
            nn.Dropout(self.do),
 
            nn.Flatten(),
 
            nn.Linear(2700, 1024),
            nn.GELU(),
            nn.Dropout(self.do)
        )

        self.comb_stack = nn.Sequential(
            nn.Linear(2048, 512),
            nn.GELU(),
            nn.Dropout(self.do),

            nn.Linear(512, self.n_coeffs)
        )

    def forward(self, x):
        x = x.transpose(2, -1).contiguous()
        x1 = self.vert_stack(x)
        x2 = self.horz_stack(x)
        x = torch.cat([x1, x2], 1)
        return self.comb_stack(x)
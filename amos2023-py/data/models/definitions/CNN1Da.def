class CNN1Da(nn.Module):
    def __init__(self, settings):
        super().__init__()
        LRELU_grad = settings["LReLU_grad"]
        do = settings["dropout_rate"]
        n_coeffs = settings["n_coeffs"]
        self.flatten = nn.Flatten()

        self.model_stack = nn.Sequential(
            nn.Linear(3*n_coeffs, 3*n_coeffs),
            nn.LeakyReLU(LRELU_grad, True),
            nn.Dropout(do),

            nn.Conv1d(1, 16, 7, padding=6),                         # 1x144 -> 16x150
            nn.LeakyReLU(LRELU_grad, True),
            nn.Dropout(do),
 
            nn.Conv1d(16, 32, kernel_size=5, padding=4, groups=4),  # 16x150 -> 32x154
            nn.LeakyReLU(LRELU_grad, True),
            nn.Dropout(do),

            nn.Conv1d(32, 32, kernel_size=3, padding=2, dilation=2, groups=4),  # 32x154 -> 32x154
            nn.LeakyReLU(LRELU_grad, True),
            nn.Dropout(do),
            
            nn.Conv1d(32, 16, kernel_size=3, padding=2, groups=4),  # 32x154 -> 16x156
            nn.LeakyReLU(LRELU_grad, True),
            nn.MaxPool1d(kernel_size=2),                            # 16x156 -> 16x78
 
            nn.Flatten(),
 
            nn.Linear(1248, 256),
            nn.LeakyReLU(LRELU_grad, True),
            nn.Dropout(do),
            nn.Linear(256, n_coeffs)

        )
    def forward(self, x):
        x = self.flatten(x)
        # x = x.transpose(1, 2).contiguous()
        return self.model_stack(x)